# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# PostgreSQL (Prisma). Optional locally — the app falls back to in-memory demo data.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/forex_analysis?schema=public

# Optional Clerk Authentication (leave empty to use built-in JWT auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional live quote providers
# OPEN_ER_API is used by default (no key). CoinGecko is used for BTC/ETH.
COINGECKO_API_KEY=

# Demo admin bootstrap (used when DATABASE_URL is set and seed runs)
ADMIN_EMAIL=admin@nexusfx.local
ADMIN_PASSWORD=ChangeMeNow!23
